{
  "name": "@mcdp-adk/pi-telegram-notify",
  "version": "0.2.1",
  "description": "Pi package that sends a Telegram message when pi finishes, fails, or waits for you",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "src/extension.ts",
  "pi": {
    "extensions": [
      "src/extension.ts"
    ]
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "tsc -p . && knip && node scripts/check-source.ts",
    "test": "node test/run.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.19.0",
    "knip": "^6.41.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcdp-adk/pi-telegram-notify.git"
  }
}
