{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    // Only the extension source is checked; pi's shipped .d.ts files are
    // not ours to fix (e.g. their JSON imports need attributes nodenext
    // demands of them, not of us).
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "test", "scripts", "commitlint.config.ts"]
}
